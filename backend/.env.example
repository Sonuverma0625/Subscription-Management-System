NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public&pgbouncer=true"
# Optional: use a managed PostgreSQL pool for serverless API traffic.
DATABASE_URL_POOLED=
# Required for the protected Vercel Cron endpoint; use a fresh random value (32+ characters).
CRON_SECRET=
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COMPANY_NAME=Darkside
COMPANY_EMAIL=billing@brightloop.com
COMPANY_ADDRESS=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Darkside <billing@brightloop.com>
OVERDUE_EMAILS=false
PASSWORD_RESET_URL=http://localhost:5173/reset-password
APP_URL=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
