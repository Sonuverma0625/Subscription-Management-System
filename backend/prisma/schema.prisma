generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  SOFTWARE
  HARDWARE
  OTHER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountAppliesTo {
  PRODUCT
  SUBSCRIPTION
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
}

enum PaymentProvider {
  MANUAL
  RAZORPAY
}

enum PaymentAttemptStatus {
  PENDING
  FAILED
  SUCCEEDED
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  passwordHash      String
  role              UserRole       @default(CUSTOMER)
  isActive          Boolean        @default(true)
  resetTokenHash    String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  customer          Customer?
  createdSubscriptions Subscription[] @relation("SubscriptionCreator")
  recordedPayments  Payment[]      @relation("PaymentRecorder")
  auditLogs         AuditLog[]
  notifications     Notification[]
  refreshSessions   RefreshSession[]

  @@index([role])
  @@index([isActive])
  @@index([resetTokenHash])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Customer {
  id           String         @id @default(cuid())
  userId       String         @unique
  companyName  String
  phone        String?
  address      String?
  gstin        String?
  taxId        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices     Invoice[]

  @@index([companyName])
}

model Product {
  id                String              @id @default(cuid())
  name              String
  type              ProductType         @default(SERVICE)
  salesPrice        Decimal             @db.Decimal(12, 2)
  costPrice         Decimal             @db.Decimal(12, 2)
  notes             String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  variants          ProductVariant[]
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]
  discounts         Discount[]
  taxes             Tax[]

  @@index([name])
  @@index([type])
  @@index([isActive])
}

model ProductVariant {
  id                String                  @id @default(cuid())
  productId         String
  attribute         String
  value             String
  extraPrice        Decimal                 @default(0) @db.Decimal(12, 2)
  createdAt         DateTime                @default(now())
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]

  @@unique([productId, attribute, value])
  @@index([productId])
}

model Plan {
  id              String          @id @default(cuid())
  name            String
  price           Decimal         @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  minQuantity     Int             @default(1)
  startDate       DateTime?
  endDate         DateTime?
  autoClose       Boolean         @default(false)
  allowCloseEarly Boolean         @default(true)
  allowPause      Boolean         @default(true)
  allowRenew      Boolean         @default(true)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptions   Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingSubscriptionPlan")
  templates       QuotationTemplate[]

  @@index([isActive])
  @@index([billingPeriod])
  @@index([startDate, endDate])
}

model QuotationTemplate {
  id           String                  @id @default(cuid())
  name         String
  validityDays Int
  planId       String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines        QuotationTemplateLine[]

  @@index([planId])
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([productId])
}

model Subscription {
  id              String                 @id @default(cuid())
  number          String                 @unique
  customerId      String
  planId          String
  startDate       DateTime
  expiryDate      DateTime?
  quotationValidUntil DateTime?
  nextBillingDate DateTime?
  paymentTerms    String?
  status          SubscriptionStatus     @default(DRAFT)
  pausedAt        DateTime?
  closedAt        DateTime?
  pendingPlanId   String?
  createdBy       String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan            Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  pendingPlan     Plan?                 @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  creator         User                  @relation("SubscriptionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  lines           SubscriptionLine[]
  discounts       SubscriptionDiscount[]
  invoices        Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([planId])
  @@index([nextBillingDate])
  @@index([startDate, expiryDate])
}

model NumberSequence {
  key          String   @id
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model CompanySettings {
  id            String   @id @default("main")
  companyName   String
  companyEmail  String
  companyAddress String?
  updatedAt     DateTime @updatedAt
}

model SubscriptionLine {
  id             String            @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Decimal           @db.Decimal(12, 2)
  taxId          String?
  amount         Decimal           @db.Decimal(12, 2)
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  tax            Tax?              @relation(fields: [taxId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([productId])
  @@index([taxId])
}

model Tax {
  id          String             @id @default(cuid())
  name        String
  ratePercent Decimal            @db.Decimal(7, 4)
  isActive    Boolean            @default(true)
  productId   String?
  productType ProductType?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  product     Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines       SubscriptionLine[]

  @@index([isActive])
  @@index([productId])
  @@index([productType])
}

model Discount {
  id             String               @id @default(cuid())
  name           String
  type           DiscountType
  value          Decimal              @db.Decimal(12, 2)
  minPurchase    Decimal?             @db.Decimal(12, 2)
  minQuantity    Int                  @default(1)
  startDate      DateTime?
  endDate        DateTime?
  usageLimit     Int?
  usedCount      Int                  @default(0)
  appliesTo      DiscountAppliesTo
  productId      String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions  SubscriptionDiscount[]

  @@index([isActive, startDate, endDate])
  @@index([productId])
  @@index([appliesTo])
}

model SubscriptionDiscount {
  id             String       @id @default(cuid())
  subscriptionId String
  discountId     String
  amountApplied  Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, discountId])
  @@index([discountId])
}

model Invoice {
  id                 String          @id @default(cuid())
  number             String          @unique
  subscriptionId     String
  customerId         String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  issueDate          DateTime        @default(now())
  dueDate            DateTime
  subtotal           Decimal         @db.Decimal(12, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  amountPaid         Decimal         @default(0) @db.Decimal(12, 2)
  status             InvoiceStatus   @default(DRAFT)
  sentAt             DateTime?
  overdueReminderSentAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  subscription       Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines              InvoiceLine[]
  payments           Payment[]
  paymentAttempts    PaymentAttempt[]

  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([dueDate])
  @@index([status])
  @@index([issueDate])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(7, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  paymentDate DateTime     @default(now())
  note       String?
  recordedBy String
  provider   PaymentProvider @default(MANUAL)
  providerOrderId String?
  providerPaymentId String? @unique
  createdAt  DateTime      @default(now())
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recorder   User          @relation("PaymentRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([paymentDate])
  @@index([invoiceId])
  @@index([recordedBy])
}

model PaymentAttempt {
  id                 String               @id @default(cuid())
  invoiceId          String
  provider           PaymentProvider       @default(RAZORPAY)
  providerOrderId    String               @unique
  providerPaymentId  String?              @unique
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("INR")
  status             PaymentAttemptStatus @default(PENDING)
  attemptNumber      Int                  @default(1)
  failureReason      String?
  retryReminderCount Int                  @default(0)
  nextRetryAt        DateTime?
  lastNotifiedAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  invoice            Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
  @@index([status, nextRetryAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model DemoRequest {
  id          String           @id @default(cuid())
  name        String
  email       String
  companyName String
  message     String
  status      DemoRequestStatus @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
